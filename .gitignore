# Contenido sensible: todo lo de private/ se ignora,
# excepto el .gitkeep que mantiene la carpeta visible en el repo.
private/*
!private/.gitkeep

# Variables de entorno o configuración local con datos sensibles
.env
.env.*
config.local.js

# Archivos de sistema operativo
.DS_Store
Thumbs.db

# Configuración de editor
.vscode/